localhost {
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /auth/* {
        reverse_proxy backend:8000
    }

    handle /media/* {
        reverse_proxy backend:8000
    }

    handle /ws/chat/* {
        reverse_proxy backend:8000
    }

    handle /ws/notifications/* {
        reverse_proxy backend:8000
    }

    handle /ws/sudoku/* {
        reverse_proxy backend:8000
    }

    handle /ws/tictactoe/* {
        reverse_proxy backend:8000
    }

    handle /ws/online/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:3000
    }
}

